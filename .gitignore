# Default ignore all
*

# Keep directories so git can descend into them
!*/
!.gitignore
!README.md

# Notebook: only the tutorial
/Notebook/*
!/Notebook/SickKids_tutorial.ipynb

# Script: only these two (pre01_iBEAT is a directory -> re-include its contents)
/Script/*
!/Script/pre01_iBEAT
!/Script/pre01_iBEAT/**
!/Script/tpl_xfm_build.py

# Templates: keep everything under templates/
!/templates/**

# Ignore temporary files
**/.ipynb_checkpoints/
*.swp
*.swo
*~
.DS_Store