# Ignore everything, then re-include what is synced to GitHub
*
!*/

# Top level
!/.gitignore
!/README.md
!/environment.yml
# QC of the SickKids templates, kept as it is on GitHub for now
!/QC_sickkids/**

# Script: only neonorm.py and setup_neonorm.sh (not the tests and helper scripts of the project), plus what they read
# from the repository: Script/data/templates_md5.txt (setup_neonorm.sh checks the templates), Script/data/
# direct_qc_reference.tsv (neonorm.direct_qc_flags), Script/data/direct_qc_reference_values.tsv
# (neonorm.plot_direct_qc_by_age) and the infant SynthStrip model (not part of FreeSurfer)
/Script/*
!/Script/neonorm.py
!/Script/setup_neonorm.sh
!/Script/data/
/Script/data/*
!/Script/data/templates_md5.txt
!/Script/data/direct_qc_reference.tsv
!/Script/data/direct_qc_reference_values.tsv
!/Script/skullstrip/
/Script/skullstrip/*
!/Script/skullstrip/synthstrip/
/Script/skullstrip/synthstrip/*
!/Script/skullstrip/synthstrip/model/
!/Script/skullstrip/synthstrip/model/synthstrip.infant.1.pt

# Notebook: not on GitHub for now. The project notebooks (BCP, HCPD) show NDA data in their outputs (NDA GUIDs, ages,
# images of single visits), which must not be redistributed; the public walkthrough is docs/tutorials/.
/Notebook/

# Tutorials: the notebooks of docs/tutorials/ and the example visits of example/ (two infants of the open Baby Open
# Brains dataset, CC-BY-4.0: images, a manual brain mask, table, README with source and citation), not the files the tutorials make
# (example/out/ and anything else)
!/docs/tutorials/*.ipynb
!/docs/tutorials/example/README.md
!/docs/tutorials/example/participants.tsv
!/docs/tutorials/example/sub-ex0[12]_T[12]w.nii.gz
!/docs/tutorials/example/sub-ex01_T1w_manual_mask.nii.gz

# Templates: the BCP templates (with their cerebellums) and the MNI files; not the tpl2tpl / avgsubj edges
# (templates/tpl_xfm_build, 16 GB; setup_neonorm.sh copies them with rsync)
!/templates/BCP-atlas-for_release-Ver2.0.0/**
# not the SUITPy runs of the templates (cerebellum_suitpy/: runs, json, figure, logs; kept on disk)
/templates/BCP-atlas-for_release-Ver2.0.0/*/cerebellum_suitpy/**
# the BCP files neonorm reads (-T1, -Mask, -T1_cerebellum_suitpy_dseg; -T2: bcp_template_cerebellum), not the atlas
# labels
/templates/BCP-atlas-for_release-Ver2.0.0/*/*-Parc.nii.gz
/templates/BCP-atlas-for_release-Ver2.0.0/*/*-Seg*.nii.gz
/templates/BCP-atlas-for_release-Ver2.0.0/*/*-T1_brain_mask.nii.gz
!/templates/BCP-atlas-for_release-Ver2.0.0/*/*-T2.nii.gz
# MNI: only the files neonorm reads (skull-stripped T1w, brain mask, cerebellum mask) and the licence (its copyright
# notice must go with every copy)
!/templates/tpl-MNI152NLin2009cSym/tpl-MNI152NLin2009cSym_res-1_desc-brain_T1w.nii.gz
!/templates/tpl-MNI152NLin2009cSym/tpl-MNI152NLin2009cSym_res-1_desc-brain_mask.nii.gz
!/templates/tpl-MNI152NLin2009cSym/tpl-MNI152NLin2009cSym_res-1_cerebellum_mask.nii.gz
!/templates/tpl-MNI152NLin2009cSym/LICENSE
/templates/tpl_xfm_build/

# Never: macOS metadata, caches, editor files
._*
.DS_Store
__pycache__/
**/.ipynb_checkpoints/
*.pyc
*.swp
*.swo
*~
